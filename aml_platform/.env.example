# ============================================================================
# Overwatch AML Platform — environment template (TASK-001 / TASK-002)
#
# Copy to `.env` (next to docker-compose.yml) and fill in real values.
# NEVER commit the real .env — it is gitignored.
#
# Secrets: generate with `openssl rand -hex 32` and use ALPHANUMERIC values
# only (some init scripts embed passwords into generated SQL).
#
# Note: DATABASE_URL is assembled by docker-compose.yml from these values —
# do not define DATABASE_URL in .env (compose interpolation does not expand
# variables inside .env itself).
# ============================================================================

# --- PostgreSQL (age_db container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=age_prod_01

# Application DB roles (created by init_scripts/00-roles-from-env.sh on first boot)
AML_API_PASSWORD=REPLACE_WITH_RANDOM_HEX
AML_ETL_PASSWORD=REPLACE_WITH_RANDOM_HEX

# --- Backend authentication (TASK-002) ---
# keycloak = production default: RS256 tokens validated against the realm JWKS.
# local    = development/tests: HS256 tokens signed with JWT_SECRET_KEY
#            (required, >= 32 chars, weak values rejected at startup).
AUTH_MODE=keycloak

# Only needed when AUTH_MODE=local
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_HEX_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=aml
KEYCLOAK_AUDIENCE=aml-portal
KEYCLOAK_LEEWAY_SECONDS=30

# Keycloak server bootstrap admin (container)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Keycloak's own database (03 role/db creation moved to 00-roles-from-env.sh)
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Keycloak admin-client credentials used by /api/v1/admin provisioning.
# Required only when using the user-provisioning endpoints; no defaults.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Workflow engine (Flowable) ---
FLOWABLE_REST_URL=http://aml-flowable:8080/flowable-rest/service
FLOWABLE_USER=
FLOWABLE_PASSWORD=
FLOWABLE_TIMEOUT=10

# --- Database pool (backend) ---
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_QUERY_TIMEOUT_MS=30000
DB_ACQUIRE_TIMEOUT_S=10

# --- didvc identity provider (AWI; empty = onboarding disabled) ---
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_API_KEY=
IDENTITY_PROVIDER_TENANT=aml
IDENTITY_PROVIDER_TIMEOUT=5
IDENTITY_PROVIDER_RETRIES=2
# First-party issuance (wallet-binding credentials)
IDENTITY_PLATFORM_URL=
IDENTITY_PLATFORM_TOKEN=
# Authorized-wallet policy cap (days)
AUTHZ_MAX_DAYS=365

# --- didvc-edge pilot (compose --profile awi) ---
DIDVC_EDGE_ISSUER_BASE_URL=http://didvc-edge:8080
DIDVC_EDGE_INTERNAL_API_KEY=REPLACE_WITH_RANDOM_HEX
DIDVC_EDGE_M2M_API_KEYS=
DIDVC_EDGE_REDIRECT_URI_ALLOWLIST=
DIDVC_EDGE_WALLET_ENDPOINT_ALLOWLIST=
